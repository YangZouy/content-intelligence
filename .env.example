# ============================================
# Content Intelligence Dispatcher - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.

# LLM 模型服务（OpenAI 兼容协议，默认使用 deepseek）
# 在 config.yaml 的 model.provider 选择：deepseek / zhipu / openai
# 填入你实际使用的那一个 key 即可（其余留占位不影响运行）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
ZHIPU_API_KEY=your-zhipu-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here

# Aliyun OSS (for image hosting)
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_BUCKET_NAME=your-bucket-name

# GitHub (for Hexo blog publishing)
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_USERNAME=your-github-username
GITHUB_HEXO_REPO=owner/hexo-repo

# WeChat (via wenyan server HTTP mode)
# Start server: wenyan serve --port 3000 --api-key your-secret-key
WECHAT_SERVER_URL=http://localhost:3000
WECHAT_SERVER_API_KEY=your-secret-key
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# 封面图获取（Unsplash，留空则走 Picsum 兜底）
UNSPLASH_ACCESS_KEY=your-unsplash-access-key